{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:boxen:schema:ai-inventory-output:1.0",
  "title": "Boxen AI inventory output",
  "description": "Schema-constrained output for one local image analysis run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scene_quality",
    "summary",
    "warnings",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "scene_quality": {
      "type": "string",
      "enum": ["good", "usable", "poor"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "warnings": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "image_blurry",
          "occluded",
          "contents_layered",
          "glare",
          "low_light",
          "cropped_objects",
          "small_objects",
          "other"
        ]
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "quantity",
          "unit",
          "confidence",
          "bounding_box",
          "attributes",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "quantity": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 9999
          },
          "unit": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 24
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "bounding_box": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["x", "y", "width", "height"],
            "properties": {
              "x": {"type": "number", "minimum": 0, "maximum": 1},
              "y": {"type": "number", "minimum": 0, "maximum": 1},
              "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
              "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
            }
          },
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["color", "material", "brand", "model", "visible_text"],
            "properties": {
              "color": {"type": ["string", "null"], "maxLength": 80},
              "material": {"type": ["string", "null"], "maxLength": 80},
              "brand": {"type": ["string", "null"], "maxLength": 120},
              "model": {"type": ["string", "null"], "maxLength": 120},
              "visible_text": {"type": ["string", "null"], "maxLength": 240}
            }
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    }
  }
}
