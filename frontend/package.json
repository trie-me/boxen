{
  "name": "boxen-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "types": "openapi-typescript ../docs/system-design/contracts/openapi.yaml -o src/contracts.d.ts",
    "check": "tsc --noEmit",
    "build": "pnpm check && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "dompurify": "^3.2.0",
    "markdown-it": "^14.1.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.51.0",
    "@types/markdown-it": "^14.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "openapi-typescript": "^7.6.0",
    "prettier": "^3.9.8",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
