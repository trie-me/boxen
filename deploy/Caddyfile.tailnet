{
	admin off
	persist_config off
	auto_https disable_redirects
	# IP-address clients omit SNI; Docker's bridge IP is not the LAN certificate.
	default_sni {$BOXEN_LEGACY_HOST}
	skip_install_trust
	storage file_system /data/caddy
	pki {
		ca local {
			name "Boxen local network"
			root_cn "Boxen LAN Root CA"
			intermediate_cn "Boxen LAN Intermediate CA"
		}
	}
	servers {
		protocols h1 h2
	}
}

(public_trust) {
	handle /trust/boxen-local-ca.crt {
		root * /data/boxen-public
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=boxen-local-ca.crt"
		header Cache-Control no-store
		rewrite * /boxen-local-ca.crt
		file_server
	}
	handle /trust/ {
		root * /data/boxen-public
		header Cache-Control no-store
		header X-Content-Type-Options nosniff
		header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
		rewrite * /index.html
		file_server
	}
	handle /trust {
		redir /trust/ 302
	}
	handle /trust/* {
		respond "Not found" 404
	}
}

# Compose publishes only the specific host interfaces. Web stays private.
# Internal ports are fixed; redirects use the external HTTPS port.
https://{$BOXEN_HOST}:8443 {
	tls internal
	encode zstd gzip
	request_body {
		max_size 26MB
	}
	import public_trust
	handle {
		reverse_proxy web:8000
	}
}

http://{$BOXEN_HOST}:8080 {
	import public_trust
	handle {
		@read method GET HEAD
		redir @read https://{$BOXEN_HOST}:{$BOXEN_HTTPS_PORT:8443}{uri} 302
		respond "Boxen has moved to HTTPS. Reload the secure address before saving." 400
	}
}

# Existing LAN bookmarks lead to the new canonical origin; no cross-origin writes.
https://{$BOXEN_LEGACY_HOST}:8443 {
	tls internal
	import public_trust
	handle {
		@read method GET HEAD
		redir @read https://{$BOXEN_HOST}:{$BOXEN_HTTPS_PORT:8443}{uri} 302
		respond "Boxen has moved to its Tailscale address. Reload before saving." 400
	}
}

http://{$BOXEN_LEGACY_HOST}:8080 {
	import public_trust
	handle {
		@read method GET HEAD
		redir @read https://{$BOXEN_HOST}:{$BOXEN_HTTPS_PORT:8443}{uri} 302
		respond "Boxen has moved to its Tailscale address. Reload before saving." 400
	}
}
