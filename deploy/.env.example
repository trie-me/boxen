# Copy to deploy/.env. See docs/operations/deployment.md for the quick start
# and docs/operations/container-storage.md for every setting.
# This is Compose interpolation input, NOT a service env_file.

# Base installation: https://localhost:8443, accessible on this computer only.
# For a phone/LAN: set HOST and BIND_ADDRESS to your server's stable LAN IP.
# For Tailscale: HOST is its DNS name; BIND_ADDRESS is its Tailscale IPv4.
# HOST has no scheme, path or port. Compose derives BOXEN_ORIGIN from it.
BOXEN_HOST=localhost
BOXEN_BIND_ADDRESS=127.0.0.1
BOXEN_HTTPS_PORT=8443

# editor = anyone who can connect may edit; viewer = read only; off = sign-in.
# Administration always requires an owner account created with init's token.
BOXEN_ANONYMOUS_ACCESS=editor

# Local build tags, NOT published Docker Hub images. Build before init/start.
BOXEN_IMAGE=boxen:0.1.0
BOXEN_CADDY_IMAGE=boxen-caddy:0.1.0
BOXEN_AI_IMAGE=boxen-ai:0.1.0
# Optional: changing the project name selects a different set of data volumes.
# COMPOSE_PROJECT_NAME=boxen

# Optional local AI: select compose.ai-local.yaml + compose.ai-build.yaml.
# Import a complete verified profile with model-import before starting AI.
# Leave PROFILE empty for the base installation; AI overlays require a value.
BOXEN_AI_PROFILE=
BOXEN_AI_THREADS=8
BOXEN_AI_CPUS=8
BOXEN_AI_MEMORY=8g

# Optional remote AI: select compose.ai-remote.yaml INSTEAD of local AI.
# Set PROFILE above and provide metadata at <PROFILES_DIR>/<PROFILE>/manifest.json.
# BOXEN_AI_BASE_URL=https://ai.example.test:8443
# BOXEN_AI_PROFILES_DIR=/absolute/private/remote-profiles
BOXEN_AI_ALLOW_INSECURE_HTTP=false
# Add compose.ai-remote-auth.yaml for a bearer-token FILE, never a token value.
# BOXEN_AI_API_KEY_SOURCE=/absolute/private/keys/ai-api.key
# Add compose.ai-remote-ca.yaml for a custom public CA bundle.
# BOXEN_AI_CA_SOURCE=/absolute/private/keys/ai-ca.pem

# Optional OIDC: select compose.oauth.yaml. Directory contains providers.json
# and private client-secret files, readable by container UID 10001.
# BOXEN_OAUTH_CONFIG_DIR=/absolute/private/boxen-oauth

# Optional extended Tailscale profile: select compose.tailnet.yaml.
# Set HOST to tailnet DNS and BIND_ADDRESS to the host's Tailscale IPv4 above.
# This adds IPv6 and HTTP/HTTPS redirects from an old LAN IPv4 address.
# BOXEN_TAILNET_IPV6=fd7a:115c:a1e0::1234
# BOXEN_LEGACY_HOST=192.0.2.10
# BOXEN_HTTP_PORT=8000
