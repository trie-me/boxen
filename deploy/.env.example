# Compose interpolation only; do not pass this file as a service env_file.
# Copy alongside compose.yaml as .env, or select it using --env-file.
# Set these to your eventual Docker Hub namespace/tags (or immutable digests).
BOXEN_IMAGE=boxen:0.1.0
BOXEN_CADDY_IMAGE=boxen-caddy:0.1.0
BOXEN_AI_IMAGE=boxen-ai:0.1.0

# Safe local default: https://localhost:8443. BOXEN_HOST must be a single DNS
# name or IP, without scheme/path/port; bracket an IPv6 address.
# For LAN access set BOTH host and bind to your machine's reachable LAN IP,
# e.g. BOXEN_HOST=192.168.1.50 and BOXEN_BIND_ADDRESS=192.168.1.50.
# BOXEN_ORIGIN is derived as https://BOXEN_HOST:BOXEN_HTTPS_PORT by Compose;
# do not set a separate origin. Container TLS always listens on 8443.
BOXEN_HOST=localhost
BOXEN_BIND_ADDRESS=127.0.0.1
BOXEN_HTTPS_PORT=8443
BOXEN_ANONYMOUS_ACCESS=editor

# Base web/worker need no AI configuration and have no external network access.
# Start initialization explicitly: docker compose run --rm init
# Then start the services: docker compose up -d
# Keep the token printed by the init command private; it is not Docker-logged.

# Optional local AI: add -f compose.ai-local.yaml; first provision the named
# boxen-models volume with a provisioned profile at /models/<profile>.
# Use the explicit model-import service with the source profile mounted at
# /source:ro. It alone gets writable /models and file-ownership capabilities.
# The one-off import also needs --cap-add CHOWN --cap-add DAC_OVERRIDE because
# routine containers drop all capabilities. Keep /source read-only.
# All files/directories must be readable/traversable by UID 10001; runtime must
# also be executable. Web/worker read the same full tree to verify checksums.
# Set a profile before choosing EITHER AI overlay; empty leaves base AI disabled.
BOXEN_AI_PROFILE=
BOXEN_AI_THREADS=8
BOXEN_AI_CPUS=8
BOXEN_AI_MEMORY=8g
# Source builds: add compose.build.yaml; local AI also needs compose.ai-build.yaml.

# Optional remote AI: add -f compose.ai-remote.yaml INSTEAD of local AI.
# Provision metadata at <absolute directory>/<profile>/manifest.json (and any
# profile-required metadata). Only that metadata directory is mounted /models.
# Remote mode requires an explicit endpoint; no default URL or remote credentials.
# BOXEN_AI_BASE_URL=https://ai.example.test:8443
# BOXEN_AI_PROFILES_DIR=/absolute/private/remote-profiles
BOXEN_AI_ALLOW_INSECURE_HTTP=false

# Optional authentication: add compose.ai-remote-auth.yaml and set the source
# file path. Optional private CA: add compose.ai-remote-ca.yaml and set its path.
# Source files must already exist and be readable by container UID 10001.
# BOXEN_AI_API_KEY_SOURCE=/absolute/private/keys/ai-api.key
# BOXEN_AI_CA_SOURCE=/absolute/private/keys/ai-ca.pem
# Do not define empty BOXEN_AI_API_KEY_FILE or BOXEN_AI_CA_FILE variables.
