{
    admin off
    auto_https disable_redirects
    skip_install_trust
    # IP-address clients omit TLS SNI; select the configured site's certificate.
    default_sni {$BOXEN_HOST:localhost}
}

# Container TLS port is fixed; Compose maps the chosen public port to 8443.
# BOXEN_HOST is also used to derive the app's exact browser origin.
https://{$BOXEN_HOST:localhost}:8443 {
    tls internal
    encode zstd gzip
    request_body {
        max_size 26MB
    }
    reverse_proxy web:8000
}
