# Only source needed by the app and proxy builds can enter the build context.
**
!Dockerfile
!pyproject.toml
!uv.lock
!frontend/
!frontend/package.json
!frontend/pnpm-lock.yaml
!frontend/pnpm-workspace.yaml
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!backend/
!backend/boxen/
!backend/boxen/**
!deploy/
!deploy/Dockerfile.caddy
!deploy/Caddyfile
!deploy/Caddyfile.tailnet
!scripts/
!scripts/import_container_profile.py
!docs/
!docs/help/
!docs/help/*.md
!docs/operations/
!docs/operations/*.md

# These exclusions come last: no source allowlist may re-include private state.
